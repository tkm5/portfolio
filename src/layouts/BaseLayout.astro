---
/**
 * Root document shared by every page: metadata, Cloudflare Web Analytics and the
 * theme bootstrap that used to come from next-themes.
 */
import { ClientRouter } from 'astro:transitions';
import '@/styles/global.css';
import { siteConfig } from '@/data/siteConfig';
import { defaultLocale, type Locale } from '@/i18n';

interface Props {
  /** Page locale, written to `<html lang>`. */
  locale?: Locale;
  /** Document title. */
  title?: string;
  /** Meta description. */
  description?: string;
}

const {
  locale = defaultLocale,
  title = siteConfig.name,
  description = siteConfig.description,
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Apply the stored theme before first paint so dark mode never flashes.
      // Same storage key and default ('dark') as the previous next-themes setup.
      function applyStoredTheme() {
        try {
          var stored = localStorage.getItem('theme') || 'dark';
          var theme =
            stored === 'system'
              ? window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light'
              : stored;
          var root = document.documentElement;
          root.classList.remove('light', 'dark');
          root.classList.add(theme);
          if (theme === 'light' || theme === 'dark') root.style.colorScheme = theme;
        } catch (e) {}
      }
      applyStoredTheme();
      // ClientRouter replaces <html> attributes on navigation, so re-apply the
      // theme right after each swap (still before paint).
      if (!window.__themeSwapBound) {
        window.__themeSwapBound = true;
        document.addEventListener('astro:after-swap', applyStoredTheme);
      }
    </script>
    <ClientRouter />
    <slot name="head" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />
    {
      siteConfig.cloudflareAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: siteConfig.cloudflareAnalyticsToken, spa: true })}
        />
      )
    }
  </head>
  <body>
    <div style="display: none">Impact-Site-Verification: 578d421e-1081-463d-918b-ec5e29c5b9db</div>
    <slot />
  </body>
</html>
