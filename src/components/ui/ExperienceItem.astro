---
import type { Experience } from '@/types';
import type { Locale } from '@/i18n';
import { getLocalizedText } from '@/utils/locale';

interface Props {
  experience: Experience;
  locale: Locale;
}

const { experience, locale } = Astro.props;
const company = getLocalizedText(experience.company, locale);
const role = getLocalizedText(experience.role, locale);
---

<div class="mb-8">
  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1 mb-1">
    <span class="text-base text-foreground">{company}</span>
    <span class="text-sm text-muted">{experience.period}</span>
  </div>
  <p class="text-sm text-muted">{role}</p>
</div>
