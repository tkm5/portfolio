---
import { getTranslations, type Locale } from '@/i18n';

interface Props {
  href: string;
  locale: Locale;
  labelKey?: 'back' | 'backToHome';
}

const { href, locale, labelKey = 'back' } = Astro.props;
const label =
  labelKey === 'backToHome'
    ? getTranslations(locale, 'contact').backToHome
    : getTranslations(locale, 'project').back;
---

<a
  href={href}
  class="inline-flex items-center gap-2 text-sm text-muted hover:text-link-hover transition-colors mb-8"
>
  <span>&lt;</span>
  <span>{label}</span>
</a>
