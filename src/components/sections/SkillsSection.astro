---
import { skills } from '@/data/skills';
import { getTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const t = getTranslations(Astro.props.locale, 'skills');
---

<section class="py-4" id="skills">
  <h2 class="text-lg md:text-xl text-muted uppercase tracking-widest mt-12 mb-6">
    {t.title}
  </h2>
  {
    skills.map((category) => (
      <div class="mb-6">
        <p class="text-sm text-muted mb-2">{category.title}</p>
        <p class="text-foreground text-sm">{category.skills}</p>
      </div>
    ))
  }
</section>
