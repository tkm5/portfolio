---
import { getTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const t = getTranslations(Astro.props.locale, 'about');
---

<section class="py-4" id="about">
  <h2 class="text-lg md:text-xl text-muted uppercase tracking-widest mt-12 mb-6">
    {t.title}
  </h2>
  <p class="text-foreground leading-relaxed">{t.description}</p>
</section>
