---
import ExperienceItem from '@/components/ui/ExperienceItem.astro';
import { experiences } from '@/data/experiences';
import { getTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getTranslations(locale, 'experience');
---

<section class="py-4" id="experience">
  <h2 class="text-lg md:text-xl text-muted uppercase tracking-widest mt-12 mb-6">
    {t.title}
  </h2>
  {experiences.map((experience) => <ExperienceItem experience={experience} locale={locale} />)}
</section>
